@{
    ViewData["Title"] = "Dashboard";
}

<div class="ems-hero">
    <div class="container text-center py-5">
        <span class="ems-badge mb-3">
            <i class="bi bi-stars"></i> Employee Management Suite
        </span>
        <h1 class="ems-hero-title">Employee Management System</h1>
        <p class="ems-hero-subtitle">
            Manage employees, attendance, salary records and analytics —
            all in one clean dashboard.
        </p>
    </div>
</div>

<div class="container">
    <div class="row g-4 m-1 ems-cards-row">

        <div class="col-md-6 col-lg-3">
            <div class="ems-card">
                <div class="ems-icon ems-icon-blue">
                    <i class="bi bi-people-fill"></i>
                </div>
                <h5 class="ems-card-title">Employees</h5>
                <p class="ems-card-text">
                    Manage employee records and profiles.
                </p>
                <a asp-controller="Employees"
                   asp-action="Index"
                   class="ems-btn ems-btn-blue">
                    View Employees <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="ems-card">
                <div class="ems-icon ems-icon-green">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>
                <h5 class="ems-card-title">Aggregates</h5>
                <p class="ems-card-text">
                    View salary and employee statistics.
                </p>
                <a asp-controller="Employees"
                   asp-action="Aggregates"
                   class="ems-btn ems-btn-green">
                    View Aggregates <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="ems-card">
                <div class="ems-icon ems-icon-amber">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>
                <h5 class="ems-card-title">Grouping</h5>
                <p class="ems-card-text">
                    Analyze grouped employee data.
                </p>
                <a asp-controller="Employees"
                   asp-action="Grouping"
                   class="ems-btn ems-btn-amber">
                    View Grouping <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="ems-card">
                <div class="ems-icon ems-icon-dark">
                    <i class="bi bi-calendar-check-fill"></i>
                </div>
                <h5 class="ems-card-title">Attendance</h5>
                <p class="ems-card-text">
                    Track employee attendance records.
                </p>
                <a asp-controller="Employees"
                   asp-action="Index"
                   class="ems-btn ems-btn-dark">
                    View Attendance <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

    </div>
</div>