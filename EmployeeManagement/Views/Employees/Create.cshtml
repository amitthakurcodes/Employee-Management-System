@model EmployeeInputModel

@{
    ViewData["Title"] = "Create";
}

<div class="form-page-header mb-4">
    <h1 class="page-title mb-1">
        <i class="bi bi-person-plus-fill text-primary me-2"></i>Create Employee
    </h1>
    <p class="text-muted mb-0">Fill in the details to add a new employee record.</p>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="form-card">
            <form asp-action="Create" asp-controller="Employees" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-section-label"><i class="bi bi-info-circle"></i> Basic Information</div>

                <div class="form-group mb-3">
                    <label asp-for="EmployeeName" class="form-label-custom"></label>
                    <input asp-for="EmployeeName" class="form-control" placeholder="Enter employee name" />
                    <span asp-validation-for="EmployeeName" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Gender" class="form-label-custom"></label>
                        <select asp-items="@Html.GetEnumSelectList<Gender>()" asp-for="Gender" class="form-select"></select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="JoiningDate" class="form-label-custom"></label>
                        <input asp-for="JoiningDate" class="form-control" type="date" />
                        <span asp-validation-for="JoiningDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Salary" class="form-label-custom"></label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input asp-for="Salary" class="form-control" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Salary" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Picture" class="form-label-custom"></label>
                        <input asp-for="Picture" class="form-control" type="file" />
                        <span asp-validation-for="Picture" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group form-check form-switch mb-4">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive" role="switch" />
                    <label class="form-check-label" asp-for="IsActive">@Html.DisplayNameFor(model => model.IsActive)</label>
                </div>

                <div class="form-group mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-section-label mb-0"><i class="bi bi-calendar-check"></i> Attendances</div>
                        <button formnovalidate type="submit" name="operation" value="add" class="ems-btn ems-btn-blue btn-sm">
                            <i class="bi bi-plus-lg"></i> Add Row
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table attendance-table align-middle">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>In Time</th>
                                    <th>Out Time</th>
                                    <th width="70"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Attendances.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <input asp-for="@Model.Attendances[i].AttendanceDate" class="form-control form-control-sm" type="date" />
                                            <span asp-validation-for="@Model.Attendances[i].AttendanceDate" class="text-danger"></span>
                                        </td>
                                        <td>
                                            <input asp-for="@Model.Attendances[i].InTime" class="form-control form-control-sm" type="text" placeholder="09:00" />
                                            <span asp-validation-for="@Model.Attendances[i].InTime" class="text-danger"></span>
                                        </td>
                                        <td>
                                            <input asp-for="@Model.Attendances[i].OutTime" class="form-control form-control-sm" type="text" placeholder="18:00" />
                                            <span asp-validation-for="@Model.Attendances[i].OutTime" class="text-danger"></span>
                                        </td>
                                        <td>
                                            <button formnovalidate type="submit" name="operation" value="del_@i" class="btn-icon btn-icon-delete">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="form-actions mt-4">
                    <button type="submit" name="operation" value="insert" class="ems-btn ems-btn-blue">
                        <i class="bi bi-check-lg"></i> Save Employee
                    </button>
                    <a asp-action="Index" class="ems-btn-outline">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}