@model IEnumerable<Employee>
@{
    ViewData["Title"] = "Aggregates";
}

<div class="form-page-header mb-4 text-center">
    <h1 class="page-title mb-1">
        <i class="bi bi-bar-chart-fill text-success me-2"></i>Aggregates
    </h1>
    <p class="text-muted mb-0">Salary statistics across all employees.</p>
</div>

<div class="row g-4 justify-content-center stat-cards-row">

    <div class="col-6 col-md-4 col-lg-2-4">
        <div class="stat-card stat-card-indigo">
            <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
            <div class="stat-label">Count</div>
            <div class="stat-value">@Model.Count()</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-lg-2-4">
        <div class="stat-card stat-card-green">
            <div class="stat-icon"><i class="bi bi-arrow-up-circle-fill"></i></div>
            <div class="stat-label">Max Salary</div>
            <div class="stat-value">₹@Model.Max(e => e.Salary)?.ToString("N0")</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-lg-2-4">
        <div class="stat-card stat-card-amber">
            <div class="stat-icon"><i class="bi bi-arrow-down-circle-fill"></i></div>
            <div class="stat-label">Min Salary</div>
            <div class="stat-value">₹@Model.Min(e => e.Salary)?.ToString("N0")</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-lg-2-4">
        <div class="stat-card stat-card-blue">
            <div class="stat-icon"><i class="bi bi-graph-up"></i></div>
            <div class="stat-label">Average Salary</div>
            <div class="stat-value">₹@Model.Average(e => e.Salary)?.ToString("N0")</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-lg-2-4">
        <div class="stat-card stat-card-dark">
            <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
            <div class="stat-label">Total Salary</div>
            <div class="stat-value">₹@Model.Sum(e => e.Salary)?.ToString("N0")</div>
        </div>
    </div>

</div>